<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_hr_job_form" model="hr.job" type="form">
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="Job Position..."/>
                    </h1>
                </div>
                <group>
                    <field name="department_id" string="Department"/>
                    <field name="active" string="Active"/>
                </group>
                <notebook>
                    <page string="Description">
                        <field name="description" string="Job Description"/>
                    </page>
                </notebook>
            </sheet>
        </view>
    </data>
</sumeru>
