<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_hr_employee_tree" model="hr.employee" type="tree">
            <field name="name"/>
            <field name="work_email"/>
            <field name="department_id"/>
            <field name="job_id"/>
            <field name="user_id"/>
            <field name="active" widget="boolean_toggle"/>
        </view>
        <view id="view_hr_employee_form" model="hr.employee" type="form">
            <form>
                <sheet>
                    <div class="sum_title">
                        <h1>
                            <field name="name" placeholder="Employee Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="work_email"/>
                            <field name="work_phone"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </view>
        <view id="view_hr_employee_kanban" model="hr.employee" type="kanban">
            <kanban>
                <field name="name"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="sum-kanban-global-click">
                            <div class="sum-kanban-content">
                                <strong class="sum-kanban-record-title">
                                    <field name="name"/>
                                </strong>
                                <div class="sum-kanban-record-body">
                                    <field name="job_id"/>
                                    <field name="department_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </view>

        <view id="view_hr_department_tree" model="hr.department" type="tree">
            <field name="name"/>
            <field name="parent_id"/>
            <field name="manager_id"/>
            <field name="active" widget="boolean_toggle"/>
        </view>
        <view id="view_hr_department_form" model="hr.department" type="form">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="manager_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </view>

        <view id="view_hr_job_tree" model="hr.job" type="tree">
            <field name="name"/>
            <field name="department_id"/>
            <field name="active" widget="boolean_toggle"/>
        </view>
        <view id="view_hr_job_form" model="hr.job" type="form">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="department_id"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </view>

        <action id="action_hr_employee" type="window" model="hr.employee" name="Employees" view_mode="kanban,tree,form">
            <help>Create your first employee.</help>
        </action>
        <action id="action_hr_department" type="window" model="hr.department" name="Departments" view_mode="tree,form"/>
        <action id="action_hr_job" type="window" model="hr.job" name="Job Positions" view_mode="tree,form"/>
    </data>
</sumeru>
