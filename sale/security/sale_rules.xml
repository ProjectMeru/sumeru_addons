<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <record id="sale_order_rule_user" model="sys.rule">
            <field name="name">sale.order: own documents</field>
            <field name="model">sale.order</field>
            <field name="domain_force">[["user_id","=","$uid"]]</field>
            <field name="active">true</field>
            <field name="perm_read">true</field>
            <field name="perm_write">true</field>
            <field name="perm_create">true</field>
            <field name="perm_unlink">true</field>
            <field name="groups" eval="[(4, ref('group_sale_user'))]"/>
        </record>
        <record id="sale_order_rule_manager" model="sys.rule">
            <field name="name">sale.order: all documents</field>
            <field name="model">sale.order</field>
            <field name="domain_force">[]</field>
            <field name="active">true</field>
            <field name="perm_read">true</field>
            <field name="perm_write">true</field>
            <field name="perm_create">true</field>
            <field name="perm_unlink">true</field>
            <field name="groups" eval="[(4, ref('group_sale_manager'))]"/>
        </record>
    </data>
</sumeru>
