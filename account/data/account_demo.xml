<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data noupdate="1">
        <record id="demo_partner_customer" model="core.partner">
            <field name="name">Demo Customer</field>
            <field name="email">customer@demo.example</field>
            <field name="is_company" eval="True"/>
            <field name="property_account_receivable_id" ref="account_receivable"/>
            <field name="property_account_payable_id" ref="account_payable"/>
        </record>
        <record id="demo_partner_vendor" model="core.partner">
            <field name="name">Demo Vendor</field>
            <field name="email">vendor@demo.example</field>
            <field name="is_company" eval="True"/>
            <field name="property_account_receivable_id" ref="account_receivable"/>
            <field name="property_account_payable_id" ref="account_payable"/>
        </record>
        <record id="demo_invoice_draft" model="account.move">
            <field name="name">INV/DEMO/0001</field>
            <field name="move_type">out_invoice</field>
            <field name="partner_id" ref="demo_partner_customer"/>
            <field name="journal_id" ref="journal_sale"/>
            <field name="date">2026-01-15</field>
            <field name="invoice_date">2026-01-15</field>
            <field name="payment_term_id" ref="payment_term_15days"/>
            <field name="state">draft</field>
            <field name="amount_untaxed" eval="1000"/>
            <field name="amount_tax" eval="180"/>
            <field name="amount_total" eval="1180"/>
            <field name="amount_residual" eval="1180"/>
            <field name="payment_state">not_paid</field>
            <field name="narration">Demo customer invoice</field>
        </record>
        <record id="demo_invoice_line" model="account.move.line">
            <field name="move_id" ref="demo_invoice_draft"/>
            <field name="name">Consulting Services</field>
            <field name="account_id" ref="account_income"/>
            <field name="tax_id" ref="tax_sale_18"/>
            <field name="quantity" eval="1"/>
            <field name="price_unit" eval="1000"/>
            <field name="price_subtotal" eval="1000"/>
            <field name="display_type">product</field>
            <field name="partner_id" ref="demo_partner_customer"/>
        </record>
    </data>
</sumeru>
