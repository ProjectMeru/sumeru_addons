<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_account_payment_tree" model="account.payment" type="tree">
            <field name="name" string="Number"/>
            <field name="payment_type" string="Type"/>
            <field name="partner_id" string="Partner"/>
            <field name="amount" string="Amount"/>
            <field name="date" string="Date"/>
            <field name="journal_id" string="Journal"/>
            <field name="invoice_id" string="Invoice"/>
            <field name="state" string="Status"/>
        </view>
        <view id="view_account_payment_form" model="account.payment" type="form">
            <header>
                <button name="action_post" string="Post" type="object" class="sum_highlight"/>
                <field name="state" widget="statusbar"/>
            </header>
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="PAY/001"/>
                    </h1>
                </div>
                <group>
                    <group string="Payment">
                        <field name="payment_type" string="Payment Type"/>
                        <field name="partner_type" string="Partner Type"/>
                        <field name="partner_id" string="Partner"/>
                        <field name="amount" string="Amount"/>
                        <field name="date" string="Date"/>
                        <field name="journal_id" string="Journal"/>
                    </group>
                    <group string="Links">
                        <field name="invoice_id" string="Invoice / Bill"/>
                        <field name="move_id" string="Journal Entry"/>
                        <field name="memo" string="Memo"/>
                    </group>
                </group>
            </sheet>
        </view>
        <record id="action_account_payments_inbound" model="sys.action.window">
            <field name="name">Customer Payments</field>
            <field name="core_model">account.payment</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[["payment_type","=","inbound"]]</field>
        </record>
        <record id="action_account_payments_outbound" model="sys.action.window">
            <field name="name">Vendor Payments</field>
            <field name="core_model">account.payment</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[["payment_type","=","outbound"]]</field>
        </record>
    </data>
</sumeru>
