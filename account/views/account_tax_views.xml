<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_account_tax_tree" model="account.tax" type="tree">
            <field name="name" string="Tax"/>
            <field name="amount" string="Amount %"/>
            <field name="type_tax_use" string="Type"/>
            <field name="account_id" string="Account"/>
            <field name="active" string="Active" widget="boolean_toggle"/>
        </view>
        <view id="view_account_tax_form" model="account.tax" type="form">
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="Tax Name"/>
                    </h1>
                </div>
                <group>
                    <field name="amount" string="Amount (%)"/>
                    <field name="type_tax_use" string="Tax Type"/>
                    <field name="account_id" string="Tax Account"/>
                    <field name="active" string="Active"/>
                </group>
            </sheet>
        </view>
        <view id="view_account_payment_term_tree" model="account.payment.term" type="tree">
            <field name="name" string="Name"/>
            <field name="days" string="Due Days"/>
            <field name="active" string="Active" widget="boolean_toggle"/>
        </view>
        <view id="view_account_payment_term_form" model="account.payment.term" type="form">
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="Immediate Payment"/>
                    </h1>
                </div>
                <group>
                    <field name="days" string="Due Days"/>
                    <field name="note" string="Description"/>
                    <field name="active" string="Active"/>
                </group>
            </sheet>
        </view>
        <record id="action_account_taxes" model="sys.action.window">
            <field name="name">Taxes</field>
            <field name="core_model">account.tax</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="action_account_payment_terms" model="sys.action.window">
            <field name="name">Payment Terms</field>
            <field name="core_model">account.payment.term</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</sumeru>
