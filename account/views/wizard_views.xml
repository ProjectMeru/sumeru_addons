<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_account_payment_register_form" model="account.payment.register" type="form">
            <sheet>
                <group>
                    <field name="invoice_id" string="Invoice"/>
                    <field name="partner_id" string="Partner"/>
                    <field name="amount" string="Amount"/>
                    <field name="journal_id" string="Payment Journal"/>
                    <field name="payment_date" string="Payment Date"/>
                    <field name="payment_type" string="Payment Type"/>
                    <field name="communication" string="Memo"/>
                </group>
            </sheet>
            <footer>
                <button name="action_create_payments" string="Create Payment" type="object" class="sum_highlight"/>
            </footer>
        </view>
        <view id="view_account_move_reversal_form" model="account.move.reversal" type="form">
            <sheet>
                <group>
                    <field name="move_id" string="Move"/>
                    <field name="date" string="Reversal Date"/>
                    <field name="reason" string="Reason"/>
                </group>
            </sheet>
            <footer>
                <button name="action_reverse_moves" string="Reverse" type="object" class="sum_highlight"/>
            </footer>
        </view>
        <record id="action_payment_register_wizard" model="sys.action.window">
            <field name="name">Register Payment</field>
            <field name="core_model">account.payment.register</field>
            <field name="view_mode">form</field>
        </record>
        <record id="action_move_reversal_wizard" model="sys.action.window">
            <field name="name">Reverse Move</field>
            <field name="core_model">account.move.reversal</field>
            <field name="view_mode">form</field>
        </record>
    </data>
</sumeru>
