<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_account_move_tree" model="account.move" type="tree">
            <field name="name" string="Number"/>
            <field name="move_type" string="Type"/>
            <field name="partner_id" string="Partner"/>
            <field name="invoice_date" string="Date"/>
            <field name="invoice_origin" string="Source"/>
            <field name="amount_untaxed" string="Untaxed"/>
            <field name="amount_tax" string="Tax"/>
            <field name="amount_total" string="Total"/>
            <field name="amount_residual" string="Due"/>
            <field name="payment_state" string="Payment"/>
            <field name="state" string="Status"/>
        </view>
        <view id="view_account_move_form" model="account.move" type="form">
            <header>
                <button name="action_post" string="Post" type="object" class="sum_highlight"/>
                <button name="action_register_payment" string="Register Payment" type="object"/>
                <button name="action_reverse" string="Credit Note" type="object"/>
                <button name="action_print_invoice" string="Print" type="object"/>
                <button name="action_draft" string="Reset to Draft" type="object"/>
                <button name="action_cancel" string="Cancel" type="object"/>
                <field name="state" widget="statusbar"/>
            </header>
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="INV/001"/>
                    </h1>
                </div>
                <group>
                    <group string="Invoice">
                        <field name="move_type" string="Type"/>
                        <field name="partner_id" string="Partner"/>
                        <field name="journal_id" string="Journal"/>
                        <field name="payment_term_id" string="Payment Terms"/>
                        <field name="date" string="Accounting Date"/>
                        <field name="invoice_date" string="Invoice Date"/>
                        <field name="invoice_date_due" string="Due Date"/>
                    </group>
                    <group string="Amounts">
                        <field name="invoice_origin" string="Source Document"/>
                        <field name="ref" string="Reference"/>
                        <field name="reversed_entry_id" string="Reversal Of"/>
                        <field name="amount_untaxed" string="Untaxed"/>
                        <field name="amount_tax" string="Tax"/>
                        <field name="amount_total" string="Total"/>
                        <field name="amount_residual" string="Amount Due"/>
                        <field name="payment_state" string="Payment Status"/>
                    </group>
                </group>
                <notebook>
                    <page string="Invoice Lines">
                        <field name="line_ids" string="Lines"/>
                    </page>
                    <page string="Notes">
                        <field name="narration" string="Notes"/>
                    </page>
                </notebook>
            </sheet>
        </view>

        <view id="view_account_move_line_tree" model="account.move.line" type="tree">
            <field name="move_id" string="Entry"/>
            <field name="display_type" string="Type"/>
            <field name="product_id" string="Product"/>
            <field name="name" string="Label"/>
            <field name="tax_id" string="Tax"/>
            <field name="quantity" string="Qty"/>
            <field name="price_unit" string="Unit Price"/>
            <field name="price_subtotal" string="Subtotal"/>
            <field name="account_id" string="Account"/>
            <field name="partner_id" string="Partner"/>
            <field name="debit" string="Debit"/>
            <field name="credit" string="Credit"/>
            <field name="amount_residual" string="Residual"/>
        </view>
        <view id="view_account_move_line_form" model="account.move.line" type="form">
            <sheet>
                <group>
                    <group string="Line">
                        <field name="move_id" string="Journal Entry"/>
                        <field name="display_type" string="Display Type"/>
                        <field name="product_id" string="Product"/>
                        <field name="name" string="Label"/>
                        <field name="account_id" string="Account"/>
                        <field name="tax_id" string="Tax"/>
                        <field name="partner_id" string="Partner"/>
                    </group>
                    <group string="Amounts">
                        <field name="quantity" string="Quantity"/>
                        <field name="price_unit" string="Unit Price"/>
                        <field name="price_subtotal" string="Subtotal"/>
                        <field name="debit" string="Debit"/>
                        <field name="credit" string="Credit"/>
                        <field name="balance" string="Balance"/>
                        <field name="amount_residual" string="Residual"/>
                    </group>
                </group>
            </sheet>
        </view>

        <record id="action_account_moves_out" model="sys.action.window">
            <field name="name">Customer Invoices</field>
            <field name="core_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[["move_type","=","out_invoice"]]</field>
        </record>
        <record id="action_account_moves_out_refund" model="sys.action.window">
            <field name="name">Customer Credit Notes</field>
            <field name="core_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[["move_type","=","out_refund"]]</field>
        </record>
        <record id="action_account_moves_in" model="sys.action.window">
            <field name="name">Vendor Bills</field>
            <field name="core_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[["move_type","=","in_invoice"]]</field>
        </record>
        <record id="action_account_moves_in_refund" model="sys.action.window">
            <field name="name">Vendor Refunds</field>
            <field name="core_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[["move_type","=","in_refund"]]</field>
        </record>
        <record id="action_account_moves" model="sys.action.window">
            <field name="name">Journal Entries</field>
            <field name="core_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[["move_type","=","entry"]]</field>
        </record>
        <record id="action_account_move_lines" model="sys.action.window">
            <field name="name">Journal Items</field>
            <field name="core_model">account.move.line</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</sumeru>
