<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_account_fiscal_position_form" model="account.fiscal.position" type="form">
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="country_id"/>
                    <field name="auto_apply"/>
                    <field name="active"/>
                    <field name="note"/>
                </group>
                <notebook>
                    <page title="Tax Mapping">
                        <field name="tax_line_ids">
                            <list editable="bottom">
                                <field name="tax_src_id"/>
                                <field name="tax_dest_id"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </view>
    </data>
</sumeru>
