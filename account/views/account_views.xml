<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_account_move_tree" model="account.move" type="tree">
            <field name="name"/>
            <field name="move_type"/>
            <field name="partner_id"/>
            <field name="invoice_origin"/>
            <field name="amount_total"/>
            <field name="payment_state"/>
            <field name="state"/>
        </view>
        <view id="view_account_move_form" model="account.move" type="form">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="sum_title">
                        <h1>
                            <field name="name" placeholder="INV/001"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="move_type"/>
                            <field name="partner_id"/>
                            <field name="journal_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="invoice_origin"/>
                            <field name="ref"/>
                            <field name="amount_total"/>
                            <field name="payment_state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Journal Items">
                            <field name="line_ids"/>
                        </page>
                        <page string="Notes">
                            <field name="narration"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </view>

        <view id="view_account_move_line_tree" model="account.move.line" type="tree">
            <field name="move_id"/>
            <field name="account_id"/>
            <field name="name"/>
            <field name="partner_id"/>
            <field name="debit"/>
            <field name="credit"/>
        </view>
        <view id="view_account_move_line_form" model="account.move.line" type="form">
            <form>
                <sheet>
                    <group>
                        <field name="move_id"/>
                        <field name="account_id"/>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="debit"/>
                        <field name="credit"/>
                        <field name="balance"/>
                    </group>
                </sheet>
            </form>
        </view>

        <view id="view_account_account_tree" model="account.account" type="tree">
            <field name="code"/>
            <field name="name"/>
            <field name="account_type"/>
            <field name="reconcile"/>
            <field name="active" widget="boolean_toggle"/>
        </view>
        <view id="view_account_account_form" model="account.account" type="form">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="account_type"/>
                        <field name="reconcile"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </view>

        <view id="view_account_journal_tree" model="account.journal" type="tree">
            <field name="code"/>
            <field name="name"/>
            <field name="type"/>
            <field name="default_account_id"/>
            <field name="active" widget="boolean_toggle"/>
        </view>
        <view id="view_account_journal_form" model="account.journal" type="form">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="type"/>
                        <field name="default_account_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </view>

        <action id="action_account_moves_out" type="window" model="account.move" name="Customer Invoices" view_mode="tree,form">
            <help>Confirm a sales order to auto-create a draft invoice, then set Status to Posted.</help>
        </action>
        <action id="action_account_moves_in" type="window" model="account.move" name="Vendor Bills" view_mode="tree,form"/>
        <action id="action_account_moves" type="window" model="account.move" name="Journal Entries" view_mode="tree,form"/>
        <action id="action_account_move_lines" type="window" model="account.move.line" name="Journal Items" view_mode="tree,form"/>
        <action id="action_account_accounts" type="window" model="account.account" name="Chart of Accounts" view_mode="tree,form"/>
        <action id="action_account_journals" type="window" model="account.journal" name="Journals" view_mode="tree,form"/>
    </data>
</sumeru>
