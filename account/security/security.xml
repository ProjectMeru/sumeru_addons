<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <record id="module_category_account" model="sys.module.category">
            <field name="name">Accounting</field>
            <field name="sequence">50</field>
        </record>
        <record id="group_account_invoice" model="core.group">
            <field name="name">Invoicing / User</field>
            <field name="category_id" ref="module_category_account"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_account_manager" model="core.group">
            <field name="name">Invoicing / Manager</field>
            <field name="category_id" ref="module_category_account"/>
            <field name="implied_ids" eval="[(4, ref('group_account_invoice'))]"/>
        </record>
    </data>
</sumeru>
