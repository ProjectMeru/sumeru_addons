<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_crm_team_tree" model="crm.team" type="tree">
            <field name="sequence" widget="handle"/>
            <field name="name"/>
            <field name="user_id"/>
            <field name="company_id"/>
        </view>

        <view id="view_crm_team_form" model="crm.team" type="form">
            <form>
                <sheet>
                    <div class="sum_title">
                        <h1>
                            <field name="name" placeholder="Sales Team Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Members" name="members">
                            <field name="member_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="email"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </view>
    </data>
</sumeru>
