<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_crm_stage_tree" model="crm.stage" type="tree">
            <field name="sequence" widget="handle"/>
            <field name="name"/>
            <field name="is_won"/>
        </view>

        <view id="view_crm_stage_form" model="crm.stage" type="form">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_won"/>
                        </group>
                    </group>
                    <separator string="Requirements"/>
                    <field name="requirements" placeholder="Give your team some guidelines to help them move opportunities to this stage."/>
                </sheet>
            </form>
        </view>
    </data>
</sumeru>
