<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <record id="view_crm_lead_form_iap_enrich" model="sys.view">
            <field name="inherit_id" ref="crm.view_crm_lead_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header/button[@name='action_set_won']" position="after">
                    <button name="enrich_lead" string="Enrich" type="object"/>
                </xpath>
                <xpath expr="//page[@string='Extra Info']/group" position="inside">
                    <field name="iap_enrich_done"/>
                </xpath>
            </field>
        </record>
    </data>
</sumeru>
