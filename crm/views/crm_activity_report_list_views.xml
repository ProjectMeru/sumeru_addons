<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_crm_activity_report_list" model="crm.activity.report" type="list" open="0">
            <field name="lead_id" string="Lead / Opportunity"/>
            <field name="user_id" string="Assigned To"/>
            <field name="team_id" string="Sales Team"/>
            <field name="stage_id" string="Stage"/>
            <field name="summary" string="Summary"/>
            <field name="date_deadline" string="Due Date"/>
            <field name="state" string="State"/>
        </view>

        <!-- Ensure mail.activity views exist when CRM is installed/updated (mail addon fallback). -->
        <view id="view_mail.activity_list" model="mail.activity" type="list">
            <field name="name" string="Activity"/>
            <field name="date_deadline" string="Due"/>
            <field name="user_id" string="Assigned"/>
            <field name="state" string="State"/>
            <field name="model" string="Model"/>
        </view>
        <view id="view_mail.activity_form" model="mail.activity" type="form">
            <sheet>
                <group>
                    <field name="name" string="Activity"/>
                    <field name="summary" string="Summary"/>
                    <field name="model" string="Model"/>
                    <field name="res_id" string="Record"/>
                    <field name="user_id" string="Assigned To"/>
                    <field name="date_deadline" string="Due Date"/>
                    <field name="state" string="State"/>
                </group>
            </sheet>
        </view>
    </data>
</sumeru>
