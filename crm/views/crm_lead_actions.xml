<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <action id="action_leads" type="window" model="crm.lead" name="Leads" view_mode="list,form"
                domain='[["type","=","lead"],["active","=",true]]'>
            <help>Use leads if you need a qualification step before creating an opportunity.</help>
        </action>
        <action id="action_opportunities" type="window" model="crm.lead" name="Pipeline" view_mode="kanban,list,form"
                view_id="view_crm_lead_pipeline_kanban"
                domain='[["type","=","opportunity"],["active","=",true]]'>
            <field name="context">{"default_type": "opportunity"}</field>
            <help>Drag opportunities across stages to update the pipeline.</help>
        </action>
        <action id="action_my_activities" type="window" model="crm.activity.report" name="My Activities" view_mode="list"
                domain='[["user_id","=","$uid"],["state","=","planned"]]'/>
        <action id="action_forecast" type="window" model="crm.lead" name="Forecast" view_mode="kanban,list,form"
                view_id="view_crm_lead_forecast_kanban"
                domain='[["type","=","opportunity"],["active","=",true],["date_deadline","!=",false]]'/>
        <action id="action_pipeline_analysis" type="window" model="crm.lead" name="Pipeline Analysis" view_mode="graph,pivot,list,form"
                domain='[["type","=","opportunity"]]'/>
        <action id="action_leads_analysis" type="window" model="crm.lead" name="Leads Analysis" view_mode="graph,pivot,list,form"
                domain='[["type","=","lead"]]'/>
        <action id="action_activity_report" type="window" model="crm.activity.report" name="Activities" view_mode="list"/>
    </data>
</sumeru>
