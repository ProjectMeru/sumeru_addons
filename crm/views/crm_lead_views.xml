<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <record id="action_crm_lead_tree" model="sys.action.window">
            <field name="name">Leads</field>
            <field name="res_model">crm.lead</field>
            <field name="view_mode">tree,form,kanban</field>
            <field name="help">Track opportunities from first contact to close.</field>
        </record>

        <record id="action_crm_lead_kanban" model="sys.action.window">
            <field name="name">Pipeline</field>
            <field name="res_model">crm.lead</field>
            <field name="view_mode">kanban,tree,form</field>
        </record>

        <view id="view_crm_lead_tree" model="crm.lead" type="tree">
            <field name="name" string="Opportunity"/>
            <field name="lead_kind" string="Type"/>
            <field name="partner_name" string="Company"/>
            <field name="contact_name" string="Contact"/>
            <field name="email" string="Email"/>
            <field name="phone" string="Phone"/>
            <field name="city" string="City"/>
            <field name="country" string="Country"/>
            <field name="stage" string="Stage"/>
            <field name="expected_revenue" string="Expected Revenue"/>
            <field name="recurring_revenue" string="MRR"/>
            <field name="probability" string="Probability"/>
            <field name="priority" string="Priority"/>
            <field name="date_deadline" string="Expected Closing"/>
            <field name="user_id" string="Salesperson"/>
            <field name="team_name" string="Sales Team"/>
        </view>

        <view id="view_crm_lead_kanban" model="crm.lead" type="kanban">
            <field name="name" string="Opportunity"/>
            <field name="partner_name" string="Company"/>
            <field name="contact_name" string="Contact"/>
            <field name="expected_revenue" string="Expected Revenue"/>
            <field name="recurring_revenue" string="MRR"/>
            <field name="probability" string="Probability"/>
            <field name="stage" string="Stage"/>
            <field name="priority" string="Priority"/>
            <field name="date_deadline" string="Expected Closing"/>
        </view>

        <view id="view_crm_lead_form" model="crm.lead" type="form">
            <header>
                <button name="action_mark_won" string="Mark Won" type="object" class="oe_highlight"/>
                <button name="action_mark_lost" string="Mark Lost" type="object"/>
                <field name="stage" string="Stage" widget="statusbar"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1>
                        <field name="name" placeholder="e.g. Acme renewal"/>
                    </h1>
                    <div class="flex space-x-4">
                        <field name="lead_kind" string="Type"/>
                        <field name="priority" string="Priority"/>
                        <field name="email" string="Email"/>
                        <field name="phone" string="Phone"/>
                        <field name="website" string="Website"/>
                    </div>
                </div>
                <group>
                    <group string="Contact">
                        <field name="partner_name" string="Company Name"/>
                        <field name="contact_name" string="Contact Name"/>
                        <field name="function" string="Job Position"/>
                    </group>
                    <group string="Revenue">
                        <field name="expected_revenue" string="Expected Revenue"/>
                        <field name="recurring_revenue" string="Recurring Revenues"/>
                        <field name="recurring_plan" string="Recurring Plan"/>
                        <field name="probability" string="Probability (%)"/>
                    </group>
                </group>
                <group>
                    <group string="Address">
                        <field name="street" string="Street"/>
                        <field name="street2" string="Street2"/>
                        <field name="city" string="City"/>
                        <field name="zip" string="Zip"/>
                        <field name="state_name" string="State"/>
                        <field name="country" string="Country"/>
                    </group>
                    <group string="Marketing">
                        <field name="campaign" string="Campaign"/>
                        <field name="medium" string="Medium"/>
                        <field name="source" string="Source"/>
                        <field name="tags" string="Tags"/>
                    </group>
                </group>
                <group>
                    <group string="Assignment">
                        <field name="user_id" string="Salesperson"/>
                        <field name="team_name" string="Sales Team"/>
                        <field name="date_deadline" string="Expected Closing"/>
                        <field name="date_closed" string="Closed Date"/>
                    </group>
                    <group string="Lost">
                        <field name="lost_reason" string="Lost Reason"/>
                    </group>
                </group>
                <notebook>
                    <page string="Internal Notes">
                        <group>
                            <field name="description" string="Notes"/>
                        </group>
                    </page>
                </notebook>
            </sheet>
            <chatter>
                <field name="description" string="Log" widget="mail_thread"/>
            </chatter>
        </view>
    </data>
</sumeru>
