<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <!-- Tree View -->
        <view id="view_crm_lead_tree" model="crm.lead" type="tree">
            <field name="name"/>
            <field name="partner_id"/>
            <field name="email_from"/>
            <field name="phone"/>
            <field name="user_id"/>
            <field name="team_id"/>
            <field name="stage_id"/>
            <field name="expected_revenue"/>
            <field name="probability"/>
        </view>

        <!-- Form View -->
        <view id="view_crm_lead_form" model="crm.lead" type="form">
            <form>
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="sum_title">
                        <h1>
                            <field name="name" placeholder="Opportunity..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="email_from"/>
                            <field name="phone"/>
                            <field name="website"/>
                        </group>
                        <group>
                            <field name="type"/>
                            <field name="date_deadline"/>
                            <field name="user_id"/>
                            <field name="team_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lead Details">
                            <group>
                                <group string="Analysis">
                                    <field name="expected_revenue"/>
                                    <field name="probability"/>
                                    <field name="recurring_revenue"/>
                                    <field name="recurring_plan"/>
                                </group>
                                <group string="Contact Info">
                                    <field name="contact_name"/>
                                    <field name="partner_name"/>
                                </group>
                            </group>
                        </page>
                        <page string="Internal Notes">
                            <field name="description"/>
                        </page>
                        <page string="Extra Info">
                            <group>
                                <field name="active"/>
                                <field name="lost_reason_id" invisible="active == True"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </view>

        <!-- Kanban View -->
        <view id="view_crm_lead_kanban" model="crm.lead" type="kanban">
            <kanban default_group_by="stage_id">
                <field name="name"/>
                <field name="expected_revenue"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="sum-kanban-global-click">
                            <div class="sum-kanban-content">
                                <div class="sum-kanban-record-top">
                                    <div class="sum-kanban-record-headings">
                                        <strong class="sum-kanban-record-title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="sum-kanban-record-body">
                                    <field name="partner_id"/>
                                    <div t-if="record.expected_revenue.raw_value">
                                        <field name="expected_revenue"/>
                                    </div>
                                </div>
                                <div class="sum-kanban-record-bottom">
                                    <div class="sum-kanban-bottom-left">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                    <div class="sum-kanban-bottom-right">
                                        <field name="user_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </view>
    </data>
</sumeru>
