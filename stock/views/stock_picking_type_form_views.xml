<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_stock_picking_type_form" model="stock.picking.type" type="form">
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="Operation Type..."/>
                    </h1>
                </div>
                <group>
                    <group string="Operation Type">
                        <field name="name" string="Operation Type"/>
                        <field name="code" string="Type of Operation"/>
                        <field name="sequence_code" string="Sequence Prefix"/>
                        <field name="active" string="Active"/>
                    </group>
                    <group string="Locations">
                        <field name="default_location_src_id" string="Default Source Location"/>
                        <field name="default_location_dest_id" string="Default Destination Location"/>
                        <field name="warehouse_id" string="Warehouse"/>
                    </group>
                </group>
                <group>
                    <group string="Options">
                        <field name="show_operations" string="Show Detailed Operations"/>
                        <field name="sequence" string="Sequence"/>
                        <field name="company_id" string="Company"/>
                    </group>
                </group>
            </sheet>
        </view>
    </data>
</sumeru>
