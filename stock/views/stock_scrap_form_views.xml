<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_stock_scrap_form" model="stock.scrap" type="form">
            <header>
                <button name="action_validate" string="Validate" type="object" class="sum_highlight"/>
                <field name="state" widget="statusbar"/>
            </header>
            <sheet>
                <group>
                    <group string="Scrap">
                        <field name="name" string="Reference"/>
                        <field name="product_id" string="Product"/>
                        <field name="scrap_qty" string="Quantity"/>
                        <field name="lot_id" string="Lot/Serial Number"/>
                    </group>
                    <group string="Flow">
                        <field name="location_id" string="Source Location"/>
                        <field name="scrap_location_id" string="Scrap Location"/>
                        <field name="picking_id" string="Transfer"/>
                        <field name="origin" string="Source Document"/>
                    </group>
                </group>
                <group>
                    <group string="Other">
                        <field name="company_id" string="Company"/>
                        <field name="date_done" string="Date"/>
                    </group>
                </group>
            </sheet>
        </view>
    </data>
</sumeru>
