        </record>
        <record id="group_stock_manager" model="core.group">
            <field name="name">Inventory / Manager</field>
            <field name="category_id" ref="module_category_stock"/>
            <field name="implied_ids" eval="[(4, ref('group_stock_user'))]"/>
        </record>
    </data>
</sumeru>
