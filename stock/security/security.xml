<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <record id="module_category_stock" model="sys.module.category">
            <field name="name">Inventory</field>
            <field name="sequence">30</field>
        </record>
        <record id="group_stock_user" model="core.group">
            <field name="name">Inventory / User</field>
            <field name="category_id" ref="module_category_stock"/>
