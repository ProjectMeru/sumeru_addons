<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_product_configurator_form" model="product.configurator" type="form">
            <sheet>
                <div class="sum_title">
                    <h1>
                        Configure Product
                    </h1>
                </div>
                <group>
                    <group string="Product">
                        <field name="product_tmpl_id" string="Template"/>
                        <field name="total_price" string="Estimated Price"/>
                    </group>
                </group>
                <field name="line_ids" string="Attributes">
                    <list editable="bottom">
                        <field name="attribute_id" string="Attribute"/>
                        <field name="value_id" string="Value"/>
                        <field name="price_extra" string="Extra Price"/>
                    </list>
                </field>
            </sheet>
            <footer>
                <button name="action_apply" string="Apply" type="object" class="sum_highlight"/>
            </footer>
        </view>
    </data>
</sumeru>
