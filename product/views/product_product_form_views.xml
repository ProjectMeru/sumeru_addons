<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_product_product_form" model="product.product" type="form">
            <sheet>
                <div class="sum_title">
                    <field name="image" widget="image"/>
                    <h1>
                        <field name="name" placeholder="Product Name..."/>
                    </h1>
                </div>
                <group>
                    <group string="General">
                        <field name="default_code" string="Internal Reference"/>
                        <field name="type" string="Product Type"/>
                        <field name="categ_id" string="Category"/>
                        <field name="active" string="Active"/>
                    </group>
                    <group string="Pricing">
                        <field name="list_price" string="Sales Price"/>
                        <field name="standard_price" string="Cost"/>
                        <field name="sale_ok" string="Can be Sold"/>
                        <field name="purchase_ok" string="Can be Purchased"/>
                    </group>
                    <group string="Variant">
                        <field name="product_tmpl_id" string="Template"/>
                        <field name="barcode" string="Barcode"/>
                        <field name="combination" string="Combination" readonly="true"/>
                        <field name="price_extra" string="Variant Extra" readonly="true"/>
                        <field name="variant_key" string="Variant Key" readonly="true"/>
                        <field name="company_id" string="Company"/>
                    </group>
                </group>
                <notebook>
                    <page string="Description">
                        <field name="description" string="Description"/>
                    </page>
                    <page string="Accounting">
                        <group>
                            <field name="property_account_income_id" string="Income Account"/>
                            <field name="property_account_expense_id" string="Expense Account"/>
                        </group>
                    </page>
                </notebook>
            </sheet>
        </view>
    </data>
</sumeru>
