<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_product_product_tree" model="product.product" type="tree">
            <field name="default_code" string="Internal Reference"/>
            <field name="name" string="Product"/>
            <field name="type" string="Type"/>
            <field name="categ_id" string="Category"/>
            <field name="list_price" string="Sales Price"/>
            <field name="standard_price" string="Cost"/>
            <field name="active" string="Active" widget="boolean_toggle"/>
        </view>
        <view id="view_product_product_form" model="product.product" type="form">
            <form>
                <sheet>
                    <div class="sum_title">
                        <h1>
                            <field name="name" placeholder="Product Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="default_code" string="Internal Reference"/>
                            <field name="type" string="Product Type"/>
                            <field name="categ_id" string="Category"/>
                            <field name="active" string="Active"/>
                        </group>
                        <group string="Pricing">
                            <field name="list_price" string="Sales Price"/>
                            <field name="standard_price" string="Cost"/>
                            <field name="sale_ok" string="Can be Sold"/>
                            <field name="purchase_ok" string="Can be Purchased"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" string="Description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </view>

        <view id="view_product_category_tree" model="product.category" type="tree">
            <field name="sequence" string="Sequence" widget="handle"/>
            <field name="name" string="Category"/>
            <field name="parent_id" string="Parent"/>
            <field name="active" string="Active" widget="boolean_toggle"/>
        </view>
        <view id="view_product_category_form" model="product.category" type="form">
            <form>
                <sheet>
                    <div class="sum_title">
                        <h1>
                            <field name="name" placeholder="Category Name..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="parent_id" string="Parent Category"/>
                        <field name="sequence" string="Sequence"/>
                        <field name="active" string="Active"/>
                    </group>
                </sheet>
            </form>
        </view>

        <action id="action_product_product" type="window" model="product.product" name="Products" view_mode="tree,form">
            <help>Create products that can be sold or purchased.</help>
        </action>
        <action id="action_product_category" type="window" model="product.category" name="Product Categories" view_mode="tree,form"/>
    </data>
</sumeru>
