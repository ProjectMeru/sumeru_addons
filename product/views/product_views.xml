<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_product_product_tree" model="product.product" type="tree">
            <field name="default_code"/>
            <field name="name"/>
            <field name="type"/>
            <field name="categ_id"/>
            <field name="list_price"/>
            <field name="standard_price"/>
            <field name="active" widget="boolean_toggle"/>
        </view>
        <view id="view_product_product_form" model="product.product" type="form">
            <form>
                <sheet>
                    <div class="sum_title">
                        <h1>
                            <field name="name" placeholder="Product Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="default_code"/>
                            <field name="type"/>
                            <field name="categ_id"/>
                        </group>
                        <group>
                            <field name="list_price"/>
                            <field name="standard_price"/>
                            <field name="sale_ok"/>
                            <field name="purchase_ok"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </view>

        <view id="view_product_category_tree" model="product.category" type="tree">
            <field name="sequence" widget="handle"/>
            <field name="name"/>
            <field name="parent_id"/>
            <field name="active" widget="boolean_toggle"/>
        </view>
        <view id="view_product_category_form" model="product.category" type="form">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </view>

        <action id="action_product_product" type="window" model="product.product" name="Products" view_mode="tree,form">
            <help>Create products that can be sold or purchased.</help>
        </action>
        <action id="action_product_category" type="window" model="product.category" name="Product Categories" view_mode="tree,form"/>
    </data>
</sumeru>
