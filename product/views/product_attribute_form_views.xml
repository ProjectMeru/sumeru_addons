<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <view id="view_product_attribute_form" model="product.attribute" type="form">
            <sheet>
                <div class="sum_title">
                    <h1>
                        <field name="name" placeholder="Attribute Name..."/>
                    </h1>
                </div>
                <group>
                    <group string="General">
                        <field name="display_type" string="Display Type"/>
                        <field name="create_variant" string="Create Variant"/>
                        <field name="sequence" string="Sequence"/>
                        <field name="active" string="Active"/>
                    </group>
                </group>
                <notebook>
                    <page string="Values">
                        <field name="value_ids" string="Values">
                            <list editable="bottom">
                                <field name="name" string="Value"/>
                                <field name="sequence" string="Sequence"/>
                                <field name="default_extra_price" string="Default Extra Price"/>
                                <field name="active" string="Active"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </view>
    </data>
</sumeru>
