<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <record id="action_stock_picking_tree" model="sys.action.window">
            <field name="name">Transfers</field>
            <field name="core_model">stock.picking</field>
            <field name="view_mode">tree,form</field>
            <field name="help">Track deliveries and receipts.</field>
        </record>

        <view id="view_picking_tree" model="stock.picking" type="tree">
            <field name="name" string="Reference"/>
            <field name="origin" string="Source"/>
            <field name="partner_name" string="Contact"/>
            <field name="picking_type_code" string="Type"/>
            <field name="scheduled_date" string="Scheduled Date"/>
            <field name="date_done" string="Date Done"/>
            <field name="location_src" string="From"/>
            <field name="location_dest" string="To"/>
            <field name="user_name" string="Responsible"/>
            <field name="priority" string="Priority"/>
            <field name="weight" string="Weight"/>
            <field name="state" string="Status"/>
        </view>

        <view id="view_picking_form" model="stock.picking" type="form">
            <header>
                <button name="action_validate" string="Validate" type="object" class="oe_highlight"/>
                <field name="state" string="Status" widget="statusbar"/>
            </header>
            <sheet>
                <group>
                    <group string="Transfer">
                        <field name="name" string="Reference"/>
                        <field name="origin" string="Source Document"/>
                        <field name="picking_type_code" string="Operation Type"/>
                        <field name="priority" string="Priority"/>
                    </group>
                    <group string="Partners &amp; Schedule">
                        <field name="partner_name" string="Contact"/>
                        <field name="scheduled_date" string="Scheduled Date"/>
                        <field name="date_done" string="Date Done"/>
                        <field name="user_name" string="Responsible"/>
                    </group>
                </group>
                <group>
                    <group string="Locations">
                        <field name="location_src" string="Source Location"/>
                        <field name="location_dest" string="Destination Location"/>
                    </group>
                    <group string="Logistics">
                        <field name="weight" string="Weight"/>
                    </group>
                </group>
                <notebook>
                    <page string="Notes">
                        <group>
                            <field name="note" string="Notes"/>
                        </group>
                    </page>
                </notebook>
            </sheet>
            <chatter>
                <field name="note" string="Log" widget="mail_thread"/>
            </chatter>
        </view>
    </data>
</sumeru>
