<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <!-- Add a manual "Receipt" button next to the purchase order status bar. -->
        <record id="view_purchase_order_form_stock" model="sys.view">
            <field name="inherit_id" ref="purchase.view_purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="before">
                    <button name="action_create_receipt" string="Receipt" type="object"/>
                </xpath>
            </field>
        </record>
    </data>
</sumeru>
