<?xml version="1.0" encoding="utf-8"?>
<sumeru>
    <data>
        <!-- Smart button linking the sales order to its delivery order,
             appended to the existing smart-button box. -->
        <record id="view_sale_order_form_stock" model="sys.view">
            <field name="inherit_id" ref="sale.view_sale_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('sum_button_box')]" position="inside">
                    <button name="action_view_deliveries" string="Deliveries" type="object"/>
                </xpath>
            </field>
        </record>
    </data>
</sumeru>
